# Vite automatically loads .env.development ONLY for `npm run dev` (never
# for `npm run build`), so this override never leaks into a production/MTA
# build by accident -- no manual "remember to unset this" step needed.
#
# Copy to .env.development for local dev (frontend on 5173 calling the
# backend directly on 8081, cross-origin).
VITE_API_BASE_URL=http://localhost:8081/api/customers
