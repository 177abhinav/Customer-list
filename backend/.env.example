PORT=8080

# Root of the OData v2 service (no trailing slash, no entity set, no $format)
SAP_ODATA_BASE_URL=https://demo21.answerthinkdemo.com/sap/opu/odata/sap/API_BUSINESS_PARTNER

# SAP client (sap-client query param)
SAP_CLIENT=100

# Never commit real credentials. This password was shared in plain text in
# chat -- rotate it on the SAP side before relying on this in anything but a
# disposable training tenant.
SAP_USERNAME=
SAP_PASSWORD=

# Comma-separated list of origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Milliseconds
SAP_REQUEST_TIMEOUT_MS=15000
